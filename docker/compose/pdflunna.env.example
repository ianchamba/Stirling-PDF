# Copy to .env.pdflunna in the repository root, which is ignored by Git.
# Set unique private values before starting. Empty credentials stop Compose.
PDFLUNNA_ADMIN_USERNAME=pdflunna-admin
PDFLUNNA_ADMIN_PASSWORD=
PDFLUNNA_API_KEY=

# Initial measurement profile. Adjust after testing representative PDFs.
PDFLUNNA_MEMORY_LIMIT=2g
PDFLUNNA_CPU_LIMIT=1.0
PDFLUNNA_PORT=8080
PDFLUNNA_QPDF_CONCURRENCY=1
PDFLUNNA_GS_CONCURRENCY=1
PDFLUNNA_PROCESSING_MAX_CONCURRENT=1
PDFLUNNA_PROCESSING_MAX_QUEUED=4
PDFLUNNA_PROCESSING_QUEUE_TIMEOUT_SECONDS=30
PDFLUNNA_JAVA_OPTS=-XX:InitialRAMPercentage=10 -XX:MaxRAMPercentage=55
PDFLUNNA_UID=1000
PDFLUNNA_GID=1000
PDFLUNNA_IMAGE=stirling-pdf-pdflunna:local
PDFLUNNA_VERSION=pdflunna-local
# Set to the Git commit used for the build.
PDFLUNNA_REVISION=unknown
